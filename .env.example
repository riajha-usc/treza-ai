# Copy to .env.local and fill in. Never commit real values.

# Airwallex sandbox: Account > Developer > API keys at sandbox.airwallex.com
AIRWALLEX_ENV=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
# Signing secret from your Airwallex webhook subscription
AIRWALLEX_WEBHOOK_SECRET=

# Claude API key. Optional: without it, gray-zone purchases go to the approval queue.
ANTHROPIC_API_KEY=

# Claude Opus 5.5 on Amazon Bedrock for dispute evidence parsing. Optional.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1

# Hosted Postgres for deployment. Leave empty to use embedded Postgres locally.
DATABASE_URL=

PLATFORM_NAME=Meridian Market

# Sandbox seller identities for connected account onboarding (Kits 05 and 08).
# Fill these in yourself with sandbox test values. Never commit real values.
# One line of JSON, keyed by seller:
# SELLER_IDENTITIES={"seller_lumen":{"ein":"...","person":{"identificationType":"PASSPORT","number":"...","issuingCountry":"US"}},"seller_harbor":{...},"seller_kestrel":{...}}
SELLER_IDENTITIES=
